{
  "manifest_version": 3,
  "name": "Application Tracker",
  "version": "0.5.0",
  "description": "Archive a company page and copy the active candidate's prompt.",
  "permissions": [
    "contextMenus",
    "scripting",
    "nativeMessaging",
    "pageCapture",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*"]
  },
  "action": {
    "default_title": "Application Tracker candidate",
    "default_popup": "popup.html"
  },
  "commands": {
    "check-selected-company": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Copy job description and URL, including the selected company when present"
    }
  }
}
